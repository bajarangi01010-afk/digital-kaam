# ==============================================================================
# DIGITAL KAAM 2.0 — ZERO COST PRODUCTION CONFIGURATION (.env)
# ==============================================================================

# 1. Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# 2. Free Indian SMS Gateway (Fast2SMS - ₹50 recharge gets ~500 real SMS OTPs)
# Get free key from: https://www.fast2sms.com/
FAST2SMS_API_KEY=

# 3. Meta WhatsApp Cloud API (Free 1,000 WhatsApp OTPs / Month)
# Get free token from: https://developers.facebook.com/
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_TOKEN=

# 4. Razorpay Payment Gateway (Free Account, 0 Monthly Fee)
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# 5. Admin Master Password
ADMIN_PASSWORD=password@123#
