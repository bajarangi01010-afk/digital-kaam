# Digital Kaam — Environment Variables Configuration
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# 1. SMART BRAIN BACKEND CONFIG
# -----------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
SB_ENV=development
# Secure production JWT secret (generate with: openssl rand -hex 32)
SB_JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
# Admin master API key for dispute resolution
SB_ADMIN_API_KEY=your_admin_master_api_key_here

# -----------------------------------------------------------------------------
# 2. PERSISTENT DATABASE (Optional: Leave blank for automatic local SQLite)
# -----------------------------------------------------------------------------
# For free Supabase/Neon PostgreSQL:
# DATABASE_URL=postgresql://postgres:[password]@db.supabase.co:5432/postgres
DATABASE_URL=

# -----------------------------------------------------------------------------
# 3. PAYMENT & ESCROW GATEWAY (Razorpay Sandbox Test Mode — ₹0 Cost)
# -----------------------------------------------------------------------------
# Get test keys from https://dashboard.razorpay.com (Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere

# -----------------------------------------------------------------------------
# 4. EXPERIENTIAL LABS LLM GATEWAY (gpt-6-astra)
# -----------------------------------------------------------------------------
# Get your API key from Settings -> API keys at Experiential Labs
EXPLABS_API_KEY=your_explabs_api_key_here
EXPERIENTIAL_BASE_URL=https://api.experientiallabs.ai/v1

# -----------------------------------------------------------------------------
# 5. FRONTEND VITE CONFIG
# -----------------------------------------------------------------------------
# URL of your deployed Smart Brain backend
VITE_API_BASE_URL=http://localhost:8000

